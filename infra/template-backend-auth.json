{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Nubixia escolar - despliegue minimo; requiere verificar cobertura gratuita",
  "Parameters": {
    "CorsOrigin": {
      "Type": "String",
      "Default": "http://localhost:4200",
      "Description": "Origen exacto del frontend, sin barra final"
    },
    "UserPoolArn": {
      "Type": "String",
      "Description": "ARN del user pool Cognito de nubixia-escolar-web"
    },
    "ApiKeyValue": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 20,
      "MaxLength": 128,
      "AllowedPattern": "[A-Za-z0-9]+",
      "Description": "Credencial alfanumerica privada para la demostracion"
    }
  },
  "Resources": {
    "PublisherFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Code": {
          "S3Bucket": "nubixia-escolar-deploy-002333107613-use2",
          "S3Key": "comprobantes-serverless-2.0.0-lambda.jar"
        },
        "Handler": "pe.nubixia.comprobantes_serverless.PublisherHandler::handleRequest",
        "MemorySize": 512,
        "Role": {
          "Fn::GetAtt": [
            "PublisherFunctionRole",
            "Arn"
          ]
        },
        "Runtime": "java17",
        "Timeout": 30,
        "Environment": {
          "Variables": {
            "TABLE_NAME": {
              "Ref": "Documents"
            },
            "BUCKET_NAME": {
              "Ref": "Artifacts"
            },
            "CORS_ORIGIN": {
              "Ref": "CorsOrigin"
            },
            "QUEUE_URL": {
              "Ref": "Queue"
            }
          }
        },
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          }
        ]
      }
    },
    "Documents": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "documentId",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "documentId",
            "KeyType": "HASH"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": false
        },
        "StreamSpecification": {
          "StreamViewType": "NEW_IMAGE"
        }
      }
    },
    "ApiFunctionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Action": [
                "sts:AssumeRole"
              ],
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com"
                ]
              }
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyName": "ApiFunctionRolePolicy0",
            "PolicyDocument": {
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:Scan"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Documents",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "${Artifacts.Arn}/*"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          }
        ],
        "RoleName": "nubixia-escolar-ApiFunctionRole-demo"
      }
    },
    "Artifacts": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "CorsConfiguration": {
          "CorsRules": [
            {
              "AllowedOrigins": [
                {
                  "Ref": "CorsOrigin"
                }
              ],
              "AllowedMethods": [
                "GET"
              ],
              "AllowedHeaders": [
                "*"
              ],
              "MaxAge": 300
            }
          ]
        }
      }
    },
    "ApiFunctionListPermissiondemo": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "ApiFunction"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": [
            "arn:aws:execute-api:${AWS::Region}:${AWS::AccountId}:${__ApiId__}/${__Stage__}/GET/comprobantes",
            {
              "__ApiId__": {
                "Ref": "Api"
              },
              "__Stage__": "*"
            }
          ]
        }
      }
    },
    "ApiFunctionDownloadPermissiondemo": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "ApiFunction"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": [
            "arn:aws:execute-api:${AWS::Region}:${AWS::AccountId}:${__ApiId__}/${__Stage__}/GET/comprobantes/*/archivos/*",
            {
              "__ApiId__": {
                "Ref": "Api"
              },
              "__Stage__": "*"
            }
          ]
        }
      }
    },
    "Queue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "VisibilityTimeout": 180,
        "MessageRetentionPeriod": 345600,
        "SqsManagedSseEnabled": true,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "DeadLetterQueue",
              "Arn"
            ]
          },
          "maxReceiveCount": 5
        }
      }
    },
    "PublisherFunctionOutbox": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "BatchSize": 10,
        "EventSourceArn": {
          "Fn::GetAtt": [
            "Documents",
            "StreamArn"
          ]
        },
        "FunctionName": {
          "Ref": "PublisherFunction"
        },
        "BisectBatchOnFunctionError": true,
        "StartingPosition": "TRIM_HORIZON",
        "FilterCriteria": {
          "Filters": [
            {
              "Pattern": "{\"eventName\":[\"INSERT\"]}"
            }
          ]
        }
      }
    },
    "ApiFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Code": {
          "S3Bucket": "nubixia-escolar-deploy-002333107613-use2",
          "S3Key": "comprobantes-serverless-2.0.0-lambda.jar"
        },
        "Handler": "pe.nubixia.comprobantes_serverless.ApiHandler::handleRequest",
        "MemorySize": 512,
        "Role": {
          "Fn::GetAtt": [
            "ApiFunctionRole",
            "Arn"
          ]
        },
        "Runtime": "java17",
        "Timeout": 30,
        "Environment": {
          "Variables": {
            "TABLE_NAME": {
              "Ref": "Documents"
            },
            "BUCKET_NAME": {
              "Ref": "Artifacts"
            },
            "CORS_ORIGIN": {
              "Ref": "CorsOrigin"
            },
            "AUTH_REQUIRED": "true"
          }
        },
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          }
        ]
      }
    },
    "PublisherFunctionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Action": [
                "sts:AssumeRole"
              ],
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com"
                ]
              }
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyName": "PublisherFunctionRolePolicy0",
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": [
                    "sqs:SendMessage*"
                  ],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Sub": [
                      "arn:${AWS::Partition}:sqs:${AWS::Region}:${AWS::AccountId}:${queueName}",
                      {
                        "queueName": {
                          "Fn::GetAtt": [
                            "Queue",
                            "QueueName"
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "ProjectStreamRead",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:DescribeStream",
                    "dynamodb:GetRecords",
                    "dynamodb:GetShardIterator"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Documents",
                      "StreamArn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:ListStreams",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "us-east-2"
                    }
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          }
        ],
        "RoleName": "nubixia-escolar-PublisherFunctionRole-demo"
      }
    },
